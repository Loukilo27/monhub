# Copier ce fichier en `.env.local` pour le développement local.
# Seules des valeurs PUBLIQUES vont ici (elles finissent dans le JavaScript du site).
# Les clés secrètes (Gemini, Last.fm, VAPID privée, service_role) vont
# exclusivement dans les secrets des Edge Functions Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
